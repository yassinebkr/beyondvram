+// MoE expert VRAM cache (BeyondVRAM PoC): returns the layer index of a fused
+// expert tensor ("blk.<N>.ffn_{gate,up,down}_exps.weight") that should be
+// created as a cap-slot CUDA tensor, or -1 when the tensor is not cacheable.
+static int llama_moe_cache_tensor_layer(const std::string & name) {
+    int cap = 0, first_layer = 0, last_layer = -1;
+    if (!ggml_cuda_moe_cache_get_config_range(&cap, &first_layer, &last_layer)) {
+        return -1;
+    }
+    int layer = -1;
+    char suffix[64];
+    if (sscanf(name.c_str(), "blk.%d.%63s", &layer, suffix) != 2) {
+        return -1;
+    }
+    if (strcmp(suffix, "ffn_gate_exps.weight") != 0 &&
+        strcmp(suffix, "ffn_up_exps.weight")   != 0 &&
+        strcmp(suffix, "ffn_down_exps.weight") != 0) {
+        return -1;
+    }
+    if (layer < first_layer || (last_layer >= 0 && layer > last_layer)) {
+        return -1;
+    }
+    return layer;
+}
 

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index ecfbae4..e4e2322 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2994,7 +2994,20 @@ llama_context * llama_new_context_with_model(
     return llama_init_from_model(model, params);
 }
 
+// BeyondVRAM repro fix: the fork never called fate_system::shutdown(). The
+// joinable prefetch worker in the static fate_system instance then hit
+// std::terminate() at process exit (rc=127 after all output had printed).
+// Shut FATE down here, while the backends are still alive: join the worker,
+// sync/destroy the prefetch stream, free pinned staging and the GPU pool.
+void llama_fate_shutdown(void) {
+    if (g_fate) {
+        g_fate->shutdown();
+        g_fate = nullptr;
+    }
+}
+
 void llama_free(llama_context * ctx) {
+    llama_fate_shutdown();
     delete ctx;
 }
 
